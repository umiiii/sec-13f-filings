#!/usr/bin/env bash
set -e

echo "[railway-start] waiting for database via pg_isready..."
attempts=0
until pg_isready -d "$DATABASE_URL" -q; do
  attempts=$((attempts + 1))
  if [ "$attempts" -ge 30 ]; then
    echo "[railway-start] pg_isready gave up after 30 attempts" >&2
    exit 1
  fi
  sleep 3
done
echo "[railway-start] database reachable after ${attempts} attempt(s)"

echo "[railway-start] running migrations..."
bundle exec rails db:migrate

TARGET_CIK="0002045724"

echo "[railway-start] seeding demo manager + enqueueing backfill..."
bundle exec rails runner '
  target_cik = "'"$TARGET_CIK"'"

  if ThirteenF.where(cik: target_cik).none?
    puts "[seed] importing filings for CIK #{target_cik}..."
    periods = [
      {year: 2025, quarter: 1},
      {year: 2025, quarter: 2},
      {year: 2025, quarter: 3},
      {year: 2025, quarter: 4},
      {year: 2026, quarter: 1}
    ]
    MinimalDbSeeder.new(ciks: [target_cik], periods: periods).seed_minimal_db!
  else
    puts "[seed] CIK #{target_cik} already present, skipping import."
  end

  # Always refresh recent filings for this CIK from SEC EDGAR atom feed.
  begin
    sec_client = SecClient.new
    recent = sec_client.latest_thirteen_f_filings(filed_since: 30.days.ago.to_date)
    my_recent = recent.select { |r| r.cik.to_s.strip.rjust(10, "0") == target_cik }
    existing = ThirteenF.where(external_id: my_recent.map(&:external_id)).pluck(:external_id).to_set
    new_rows = my_recent.reject { |r| existing.include?(r.external_id) }.map do |row|
      now = Time.current
      {
        external_id: row.external_id,
        cik: row.cik,
        name: row.company_name,
        form_type: row.form_type,
        date_filed: row.date_filed,
        directory_url: row.directory_url,
        filing_year: row.date_filed.year,
        filing_quarter: (row.date_filed.month - 1) / 3 + 1,
        created_at: now,
        updated_at: now
      }
    end
    if new_rows.any?
      ThirteenF.insert_all(new_rows, returning: false)
      puts "[refresh] imported #{new_rows.size} new filings"
    else
      puts "[refresh] no new filings for CIK #{target_cik}"
    end
    ThirteenF.process_unprocessed_filings!(ciks: [target_cik], refresh_views: true)
  rescue => e
    puts "[refresh] failed: #{e.class}: #{e.message}"
  end

  unless Delayed::Job.where("handler LIKE ?", "%DemoCikBackfill%").exists?
    DemoCikBackfill.delay(priority: 50).run!(target_cik)
    puts "[seed] queued DemoCikBackfill job"
  else
    puts "[seed] DemoCikBackfill job already queued, skipping."
  end
' || echo "[railway-start] seed step failed, continuing anyway"

echo "[railway-start] starting foreman..."
exec bundle exec foreman start -m web=1,worker=1,clock=1
